<resources>
    <style name="Theme.SaborDelHimalaya.Activation" parent="Theme.SaborDelHimalaya.Registration">
        <item name="colorPrimary">@color/welcome_button</item>
        <item name="android:colorAccent">@color/welcome_button</item>
        <item name="android:windowBackground">@color/welcome_paper</item>
    </style>
    <style name="Theme.SaborDelHimalaya.Registration" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/welcome_button</item>
        <item name="colorOnPrimary">@color/welcome_paper</item>
        <item name="colorSurface">@color/white</item>
        <item name="android:colorAccent">@color/welcome_button</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/welcome_paper</item>
    </style>
    <style name="RegistrationLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">@color/welcome_title</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
    <style name="RegistrationInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="hintEnabled">false</item>
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxStrokeColor">@color/carta_border</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>
    <style name="RegistrationEditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:padding">14dp</item>
        <item name="android:textColor">@color/welcome_title</item>
        <item name="android:textSize">16sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:imeOptions">actionNext</item>
    </style>
</resources>
