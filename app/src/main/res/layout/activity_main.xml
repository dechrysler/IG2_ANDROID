<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/welcome_paper"
    android:orientation="vertical"
    tools:context=".controller.MainActivity">

    <LinearLayout
        android:id="@+id/welcome_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_welcome_dark"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:paddingVertical="32dp">

            <ImageView
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_brand_web" />

            <TextView
                style="@style/EyebrowLabel"
                android:layout_marginTop="26dp"
                android:text="Cocina nepalesa · A domicilio"
                android:textColor="@color/accent_soft" />

            <TextView
                android:id="@+id/welcome_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="serif"
                android:includeFontPadding="false"
                android:lineSpacingExtra="2dp"
                android:text="Sabor del\nHimalaya"
                android:textColor="#FFF7ED"
                android:textSize="46sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="24dp"
                android:text="Platos tradicionales preparados al momento y llevados a tu puerta."
                android:textColor="#D9C7B7"
                android:textSize="16sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/welcome_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel_top_rounded"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:text="Tu comida favorita, a un toque"
                android:textColor="@color/welcome_title"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Pide en minutos y sigue tu pedido en tiempo real."
                android:textColor="@color/registration_text"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_login"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minHeight="54dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/action_login"
                android:textAllCaps="false"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/welcome_paper"
                app:backgroundTint="@color/welcome_button"
                app:cornerRadius="27dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_register"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:minHeight="44dp"
                android:text="@string/action_register"
                android:textAllCaps="false"
                android:textColor="@color/welcome_button"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
