<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:id="@+id/dialog_dish_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:accessibilityHeading="true"
            android:textColor="@color/welcome_title"
            android:textSize="28sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/dialog_dish_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="serif"
            android:textColor="@color/welcome_title"
            android:textSize="18sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialog_dish_minus"
                style="@style/DishQuantityButton"
                android:contentDescription="@string/dish_decrease_quantity"
                android:text="@string/dish_minus"
                android:visibility="gone" />
            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/dialog_dish_quantity"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="48dp"
                android:maxWidth="120dp"
                android:paddingHorizontal="8dp"
                android:background="@null"
                android:fontFamily="serif"
                android:gravity="center"
                android:inputType="number"
                android:imeOptions="actionDone"
                android:singleLine="true"
                android:selectAllOnFocus="true"
                android:contentDescription="@string/dish_quantity"
                android:textColor="@color/welcome_title"
                android:textSize="24sp"
                android:textStyle="bold"
                android:visibility="gone" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialog_dish_plus"
                style="@style/DishQuantityButton"
                android:contentDescription="@string/dish_increase_quantity"
                android:text="@string/dish_plus" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:baselineAligned="false">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialog_dish_back"
                style="@style/DishActionButton"
                android:layout_marginEnd="8dp"
                android:text="@string/action_back"
                android:textColor="@color/welcome_title"
                app:backgroundTint="@color/white"
                app:strokeColor="@color/welcome_title"
                app:strokeWidth="1dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialog_dish_add"
                style="@style/DishActionButton"
                android:enabled="false"
                android:text="@string/action_add"
                android:textColor="@color/dish_add_text"
                app:backgroundTint="@color/dish_add_background" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
