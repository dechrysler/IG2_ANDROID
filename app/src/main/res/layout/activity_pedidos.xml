<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/orders_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    tools:context=".controller.Pedidos">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">
        <ImageView
            android:layout_width="64dp"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_carta_lotus" />
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="16dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/activation_brand"
            android:textColor="@color/welcome_title"
            android:textSize="32sp"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="16sp"
            app:autoSizeMaxTextSize="32sp"
            app:autoSizeStepGranularity="1sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/orders_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/orders_title"
                android:textColor="@color/welcome_title"
                android:textSize="24sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/orders_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="vertical">
                <ProgressBar
                    android:id="@+id/orders_progress"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:indeterminateTint="@color/carta_accent" />
                <TextView
                    android:id="@+id/orders_state_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/orders_loading"
                    android:textColor="@color/registration_text"
                    android:textSize="17sp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_orders_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/action_retry"
                    android:textAllCaps="false"
                    android:visibility="gone"
                    app:backgroundTint="@color/welcome_button" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/orders_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="40dp"
                android:visibility="gone">
                <ImageView
                    android:layout_width="176dp"
                    android:layout_height="176dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_orders_empty" />
                <TextView
                    android:id="@+id/orders_empty_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:accessibilityHeading="true"
                    android:text="@string/orders_empty_title"
                    android:textColor="@color/welcome_title"
                    android:textSize="24sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/orders_empty_description"
                    android:textColor="@color/registration_text"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/orders_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/carta_border" />
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/orders_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:itemIconTint="@color/carta_navigation"
        app:itemTextColor="@color/carta_navigation"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/principal_navigation" />
</LinearLayout>
