<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activation_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/welcome_paper"
    tools:context=".controller.ActivacionCuenta">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="32dp"
            android:paddingBottom="40dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/activation_brand"
                android:textColor="@color/welcome_title"
                android:textSize="30sp"
                android:textStyle="bold" />
            <ImageView
                android:layout_width="128dp"
                android:layout_height="128dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_activation_mail" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:accessibilityHeading="true"
                android:text="@string/activation_title"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/registration_text" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="16dp"
                android:gravity="center"
                android:text="@string/activation_description"
                android:textSize="20sp"
                android:textColor="@color/registration_text" />
            <TextView
                android:id="@+id/activation_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="16dp"
                android:gravity="center"
                android:textColor="@color/welcome_title"
                android:textSize="20sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/activation_dev_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="16dp"
                android:gravity="center"
                android:text="@string/activation_dev_hint"
                android:textColor="@color/registration_text"
                android:textSize="14sp"
                android:visibility="gone" />
            <TextView
                style="@style/RegistrationLabel"
                android:layout_marginTop="32dp"
                android:labelFor="@+id/activation_code"
                android:text="@string/activation_code_label" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/activation_code_container"
                style="@style/RegistrationInput"
                app:boxBackgroundColor="@color/welcome_paper"
                app:boxStrokeColor="@color/activation_outline">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@id/activation_code"
                    style="@style/RegistrationEditText"
                    android:hint="@string/activation_code_hint"
                    android:inputType="textVisiblePassword"
                    android:imeOptions="actionDone" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_send_activation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/activation_send"
                android:textAllCaps="false"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/welcome_paper"
                app:backgroundTint="@color/welcome_button"
                app:cornerRadius="8dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:text="@string/activation_not_received"
                android:textSize="20sp"
                android:textColor="@color/registration_text" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_resend_activation"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:minHeight="48dp"
                android:text="@string/activation_resend"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="@color/welcome_title" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
