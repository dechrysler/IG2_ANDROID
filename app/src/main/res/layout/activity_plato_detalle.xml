<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/plato_detalle_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/welcome_paper"
    android:orientation="vertical"
    tools:context=".controller.PlatoDetalle">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">
        <ImageButton
            android:id="@+id/button_plato_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/plato_detail_title"
            android:textColor="@color/welcome_title"
            android:textSize="17sp"
            android:textStyle="bold" />
        <View
            android:layout_width="44dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <ImageView
                android:id="@+id/plato_detail_image"
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:background="@drawable/bg_image_rounded"
                android:clipToOutline="true"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_plato_placeholder" />

            <TextView
                android:id="@+id/plato_detail_category"
                style="@style/EyebrowLabel"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/plato_detail_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="serif"
                android:textColor="@color/welcome_title"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/plato_detail_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/registration_text"
                android:textSize="15sp"
                android:lineSpacingExtra="3dp" />

            <TextView
                android:id="@+id/plato_detail_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/welcome_title"
                android:textSize="24sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/carta_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/menu_detail_quantity"
                    android:textColor="@color/welcome_title"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_plato_qty_minus"
                    style="@style/DishQuantityButton"
                    android:text="−" />

                <TextView
                    android:id="@+id/plato_detail_quantity"
                    android:layout_width="46dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/welcome_title"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_plato_qty_plus"
                    style="@style/DishQuantityButton"
                    android:text="+" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_plato_add"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="12dp"
        android:minHeight="54dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/action_add"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/welcome_paper"
        app:backgroundTint="@color/welcome_button"
        app:cornerRadius="27dp" />
</LinearLayout>
