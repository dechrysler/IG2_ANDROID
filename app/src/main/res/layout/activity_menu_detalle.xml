<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/menu_detail_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".controller.MenuDetalle">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_menu_detail_back"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/action_back"
            android:textAllCaps="false"
            android:textColor="@color/welcome_title" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/menu_detail_title"
            android:textColor="@color/welcome_title"
            android:textSize="20sp"
            android:textStyle="bold" />
        <View
            android:layout_width="72dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/menu_detail_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:id="@+id/menu_detail_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="48dp">
                    <ProgressBar
                        android:id="@+id/menu_detail_progress"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:indeterminateTint="@color/carta_accent" />
                    <TextView
                        android:id="@+id/menu_detail_state_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="@string/menu_detail_loading"
                        android:textColor="@color/registration_text"
                        android:textSize="17sp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_menu_detail_retry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/action_retry"
                        android:textAllCaps="false"
                        android:visibility="gone"
                        app:backgroundTint="@color/welcome_button" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/menu_detail_form"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/menu_detail_image"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:background="@color/welcome_paper"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_plato_placeholder" />

                    <TextView
                        android:id="@+id/menu_detail_daily_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_role_badge"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="@string/menus_daily_badge"
                        android:textColor="@color/carta_accent"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/menu_detail_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/welcome_title"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/menu_detail_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/registration_text"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/menu_detail_price"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:textColor="@color/carta_accent"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/CartaSectionTitle"
                        android:layout_marginTop="24dp"
                        android:text="@string/menu_detail_products"
                        android:textSize="22sp" />

                    <LinearLayout
                        android:id="@+id/menu_detail_products"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/carta_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/menu_detail_quantity"
                            android:textColor="@color/welcome_title"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_menu_qty_minus"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:minWidth="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            android:text="−"
                            android:textColor="@color/welcome_title"
                            android:textSize="20sp"
                            app:cornerRadius="8dp"
                            app:strokeColor="@color/carta_accent" />

                        <TextView
                            android:id="@+id/menu_detail_quantity"
                            android:layout_width="48dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="@color/welcome_title"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_menu_qty_plus"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:minWidth="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            android:text="+"
                            android:textColor="@color/welcome_title"
                            android:textSize="20sp"
                            app:cornerRadius="8dp"
                            app:strokeColor="@color/carta_accent" />

                        <TextView
                            android:id="@+id/menu_detail_line_total"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:textColor="@color/carta_accent"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_menu_add"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="12dp"
        android:minHeight="56dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/menus_add"
        android:textAllCaps="false"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/welcome_paper"
        android:visibility="gone"
        app:backgroundTint="@color/welcome_button"
        app:cornerRadius="10dp" />
</LinearLayout>
